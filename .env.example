# ==============================================================================
# Nyx Production Environment Configuration (Docker Compose / Coolify)
# ==============================================================================

# Database & Cache Credentials
# In Docker Compose, these automatically provision the PostgreSQL database and wire to the server.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nyx

# Note: In Docker Compose, DATABASE_URL & REDIS_URL are automatically formatted
# to connect directly through the private Docker bridge network:
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/nyx
# REDIS_URL=redis://redis:6379

# Server Configuration
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# JWT & Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_base64_string

# Auth Token TTLs
AUTH_NONCE_TTL_SECONDS=300
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Server Retention & Realtime Configuration
MESSAGE_RETENTION_DAYS=30
REALTIME_NODE_ID=
REALTIME_ACTIVE_CONNECTION_TTL_SECONDS=90
REALTIME_MESSAGE_DEDUPE_TTL_SECONDS=86400
REALTIME_RATE_LIMIT_CAPACITY=20
REALTIME_RATE_LIMIT_REFILL_PER_SECOND=5

# Solana Integration Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed
PAYMENT_TREASURY_WALLET=11111111111111111111111111111111
PAYMENT_CREDITS_PER_SOL=1000

# CORS & WebSocket Allowed Origins (Points to your Vercel frontend)
CORS_ALLOWED_ORIGINS=https://nyx0.vercel.app
WS_ALLOWED_ORIGINS=https://nyx0.vercel.app

# Authentication Identity
AUTH_JWT_ISSUER=nyx-server
AUTH_JWT_AUDIENCE=nyx-clients
AUTH_TOKEN_VERSION=2
AUTH_SIWS_DOMAIN=nyx0.vercel.app
AUTH_SIWS_URI=https://nyx0.vercel.app
AUTH_SIWS_STATEMENT=Sign this message to authenticate with Nyx. This request will not trigger a blockchain transaction.
